---
# Ansible-lint configuration
# See https://ansible-lint.readthedocs.io/

profile: min  # Min profile: yaml syntax and basic structure only

# Exclude paths from linting
exclude_paths:
  - .cache/
  - .github/
  - .pytest_cache/
  - group_vars/all/vault.yml
  - molecule/
  - __pycache__/
  - '*.vault'

# Skip specific rules if needed
skip_list:
  - yaml[line-length]         # Long lines acceptable in STIG evidence blocks
  - yaml[empty-lines]         # Blank line separators used for readability
  - yaml[comments]            # Comment style flexible in task files
  - no-changed-when           # Enforcement tasks intentionally change state
  - command-instead-of-module # Legacy command usage in STIG audit tasks
  - command-instead-of-shell  # Shell pipes required for audit checks
  - risky-shell-pipe          # Audit validation tasks use pipes with || true
  - var-naming[no-role-prefix]# STIG control vars use V-XXXXXX prefix by design
  - name[casing]              # STIG IDs and technical terms in task names
  - name[template]            # Dynamic names needed for DNS service detection
  - role-name                 # postgresql_SRG intentional uppercase

# Enable specific rules
enable_list:
  - yaml

# Variable naming configuration
var_naming_pattern: "^[a-z_][a-z0-9_]*$"

# Warn but don't fail on these
warn_list:
  - experimental
  - role-name
  - galaxy[version-incorrect]

# Use specific Ansible version for linting
# This ensures compatibility with your Ansible version
offline: false

quiet: false
verbosity: 1

# File types to lint
kinds:
  - playbook: "**/*playbook*.{yml,yaml}"
  - tasks: "**/tasks/**/*.{yml,yaml}"
  - handlers: "**/handlers/**/*.{yml,yaml}"
  - vars: "**/vars/**/*.{yml,yaml}"
  - defaults: "**/defaults/**/*.{yml,yaml}"
  - meta: "**/meta/**/*.{yml,yaml}"
  - yaml: "**/*.{yml,yaml}"

# Mock modules and roles for offline linting
mock_modules:
  - zuul_return
  - fake_module

mock_roles:
  - mocked_role

# Tags to skip
tags: []

# Extra variables for linting
extra_vars:
  ansible_check_mode: true
