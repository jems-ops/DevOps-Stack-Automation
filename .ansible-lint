---
# Skip rules that require renaming the role directory (postgresql_SRG -> postgresql_srg)
# or are too pervasive to fix without breaking shell pipe semantics.
skip_list:
  - var-naming[no-role-prefix]  # Role name case mismatch (postgresql_SRG vs postgresql_srg_)
  - role-name                   # Role directory uses uppercase SRG intentionally
  - risky-shell-pipe            # Many validation tasks use pipes intentionally with || true
  - no-changed-when              # Enforcement tasks intentionally change state
