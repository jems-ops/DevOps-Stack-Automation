---
# Ansible-lint configuration
# See https://ansible-lint.readthedocs.io/

profile: production  # Use production profile for stricter rules

# Exclude paths from linting
exclude_paths:
  - .cache/
  - .github/
  - .pytest_cache/
  - group_vars/all/vault.yml
  - molecule/
  - __pycache__/
  - '*.vault'
  # Third-party / vendor content
  - roles/rhel8-stig/
  - playbooks/install-freeipa-server.yml
  # Virtualenvs (third-party content, not part of the Ansible codebase)
  - '**/venv/'
  - '**/.venv/'
  - saml-integration-webapp/backend/venv/
  - saml-integration-webapp/backend/.venv/
  # Node dependencies (third-party content)
  - '**/node_modules/'
  - saml-integration-webapp/frontend/node_modules/

# Skip specific rules if needed
skip_list:
  - yaml[line-length]  # Allow long lines in YAML files
  - no-changed-when  # Allow tasks without changed_when in some cases
  - command-instead-of-module  # Allow command module when appropriate

# Enable specific rules
enable_list:
  - yaml
  - var-naming[no-role-prefix]  # Enforce role variable prefixes

# Variable naming configuration
var_naming_pattern: "^[a-z_][a-z0-9_]*$"

# Warn but don't fail on these
warn_list:
  - experimental
  - role-name
  - galaxy[version-incorrect]

# Use specific Ansible version for linting
# This ensures compatibility with your Ansible version
offline: false


# File types to lint
# NOTE: Avoid "crawl the repo" patterns (like **/*.{yml,yaml}) because it makes pre-commit run ansible-lint
# against third-party/vendor trees (node_modules, venv, etc.) and unrelated playbooks.
# Let pre-commit pass the files to lint.

# Mock modules and roles for offline linting
mock_modules:
  - zuul_return
  - fake_module

mock_roles:
  - mocked_role

# Tags to skip
tags: []

# Extra variables for linting
extra_vars:
  ansible_check_mode: true
