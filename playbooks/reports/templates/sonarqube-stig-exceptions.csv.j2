# Generated by Ansible from group_vars/sonarqube/main.yml
# Fields are CSV-escaped (double quotes doubled).
"category","id","var","value","reason"
{% for ex in (sonarqube_stig_exceptions | default([])) %}
"{{ ex.category | default('os') | replace('"','""') }}","{{ ex.id | default('') | replace('"','""') }}","{{ ex.var | default('') | replace('"','""') }}","{{ (ex.value | string | lower) | replace('"','""') }}","{{ (ex.reason | default('') | replace('\r',' ') | replace('\n',' ') | trim) | replace('"','""') }}"
{% endfor %}
