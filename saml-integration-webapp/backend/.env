# Application
APP_NAME="SAML Integration API"
APP_VERSION="1.0.0"
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./saml_integration.db
# For PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/saml_integration

# Redis
REDIS_URL=redis://localhost:6379/0

# Ansible
ANSIBLE_PROJECT_ROOT=/Users/jimi/jenkins-ansible-automation
ANSIBLE_INVENTORY=inventory/hosts
ANSIBLE_PLAYBOOK=playbooks/configure-keycloak-saml-integration.yml

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Workers
MAX_CONCURRENT_DEPLOYMENTS=5
DEPLOYMENT_TIMEOUT_MINUTES=30
