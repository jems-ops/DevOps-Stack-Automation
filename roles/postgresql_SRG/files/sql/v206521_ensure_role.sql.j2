-- ============================================================
-- V-206521 — Ensure readonly role exists
-- Idempotent: only creates the role if it does not exist.
-- ============================================================
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{{ postgresql_srg_readonly_role }}') THEN
        CREATE ROLE {{ postgresql_srg_readonly_role }} NOSUPERUSER NOCREATEDB NOCREATEROLE NOLOGIN;
        RAISE NOTICE 'Created role: {{ postgresql_srg_readonly_role }}';
    ELSE
        RAISE NOTICE 'Role already exists: {{ postgresql_srg_readonly_role }}';
    END IF;
END $$;
