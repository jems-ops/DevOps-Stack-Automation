-- ============================================================
-- PostgreSQL SRG — Application DB/User Validation
-- Auto-generated by Ansible — DO NOT EDIT MANUALLY
--
-- Output: key=value pairs for Ansible parsing
-- ============================================================

-- Password encryption setting
SELECT 'password_encryption=' || current_setting('password_encryption');

{% for svc in postgresql_srg_application_services | default([]) %}
{% if svc.db_name is defined and svc.db_user is defined %}
-- {{ svc.name }}: check database exists
SELECT '{{ svc.db_user }}_db_exists='
  || CASE WHEN EXISTS (
       SELECT 1 FROM pg_database WHERE datname = '{{ svc.db_name }}'
     ) THEN 'true' ELSE 'false' END;

-- {{ svc.name }}: check user exists and can login
SELECT '{{ svc.db_user }}_user_exists='
  || CASE WHEN EXISTS (
       SELECT 1 FROM pg_roles WHERE rolname = '{{ svc.db_user }}' AND rolcanlogin = true
     ) THEN 'true' ELSE 'false' END;

-- {{ svc.name }}: check user can connect to database
SELECT '{{ svc.db_user }}_can_connect='
  || CASE WHEN has_database_privilege('{{ svc.db_user }}', '{{ svc.db_name }}', 'CONNECT')
     THEN 'true' ELSE 'false' END;

-- {{ svc.name }}: check password hash type
SELECT '{{ svc.db_user }}_hash_type='
  || CASE
       WHEN rolpassword LIKE 'SCRAM-SHA-256$$%' THEN 'SCRAM'
       WHEN rolpassword LIKE 'md5%' THEN 'MD5'
       WHEN rolpassword IS NULL THEN 'NONE'
       ELSE 'OTHER'
     END
FROM pg_authid WHERE rolname = '{{ svc.db_user }}';

{% endif %}
{% endfor %}
