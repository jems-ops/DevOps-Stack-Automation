-- ============================================================
-- PostgreSQL SRG — Application Database & User Provisioning
-- Auto-generated by Ansible — DO NOT EDIT MANUALLY
--
-- Ensures each application database and user exist with
-- SCRAM-SHA-256 password encryption.
-- ============================================================

-- Ensure password_encryption is SCRAM before creating users
ALTER SYSTEM SET password_encryption = 'scram-sha-256';
SELECT pg_reload_conf();

{% for svc in postgresql_srg_application_services | default([]) %}
{% if svc.db_name is defined and svc.db_user is defined %}
-- ===========================================================
-- {{ svc.name }}: database={{ svc.db_name }}, user={{ svc.db_user }}
-- ===========================================================

-- Ensure user exists
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{{ svc.db_user }}') THEN
        CREATE ROLE {{ svc.db_user }} LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
        RAISE NOTICE 'Created user: {{ svc.db_user }}';
    ELSE
        RAISE NOTICE 'User already exists: {{ svc.db_user }}';
    END IF;
END $$;

{% endif %}
{% endfor %}
