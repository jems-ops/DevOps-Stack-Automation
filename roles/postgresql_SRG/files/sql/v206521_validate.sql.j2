-- ============================================================
-- V-206521 — Least Privilege Validation
-- Auto-generated by Ansible — DO NOT EDIT MANUALLY
--
-- Target database : {{ postgresql_srg_target_database }}
-- Readonly role   : {{ postgresql_srg_readonly_role }}
--
-- Output: key=value pairs, one per line, for Ansible parsing
-- ============================================================

-- 1. Check PUBLIC CREATE privilege on database
SELECT 'db_create_revoked='
  || CASE WHEN has_database_privilege('public',
       '{{ postgresql_srg_target_database }}', 'CREATE')
       THEN 'false' ELSE 'true' END;

-- 2. Count schemas where PUBLIC has CREATE (excluding system schemas)
SELECT 'schema_create_leaks='
  || count(*)::text
FROM pg_namespace
WHERE has_schema_privilege('public', oid, 'CREATE')
  AND nspname NOT IN ('pg_catalog', 'information_schema');

-- 3. Count default privilege leaks (anonymous grants like =/)
SELECT 'default_acl_leaks='
  || count(*)::text
FROM pg_default_acl
WHERE defaclacl::text ~ '=/';

-- 4. Count default privilege entries for readonly role
SELECT 'rbac_default_grants='
  || count(*)::text
FROM pg_default_acl
WHERE defaclacl::text LIKE '%{{ postgresql_srg_readonly_role }}%';

-- 5. Check readonly role exists
SELECT 'readonly_role_exists='
  || CASE WHEN EXISTS (
       SELECT 1 FROM pg_roles
       WHERE rolname = '{{ postgresql_srg_readonly_role }}'
     ) THEN 'true' ELSE 'false' END;

{% if postgresql_srg_revoke_existing_objects | default(false) %}
-- 6. Count PUBLIC grants on tables (only when revoke_existing enabled)
SELECT 'public_table_grants='
  || count(*)::text
FROM information_schema.role_table_grants
WHERE grantee = 'PUBLIC'
  AND table_schema NOT IN ('pg_catalog', 'information_schema');
{% endif %}
