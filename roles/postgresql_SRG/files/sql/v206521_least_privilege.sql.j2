-- ============================================================
-- V-206521 — Least Privilege Enforcement
-- Auto-generated by Ansible — DO NOT EDIT MANUALLY
--
-- Target database : {{ postgresql_srg_target_database }}
-- Schemas         : {{ postgresql_srg_effective_schemas | join(', ') }}
-- Readonly role   : {{ postgresql_srg_readonly_role }}
-- ============================================================

-- ============================================================
-- 1. Revoke CREATE on database from PUBLIC
-- ============================================================
REVOKE CREATE ON DATABASE {{ postgresql_srg_target_database }} FROM PUBLIC;

{% for schema in postgresql_srg_effective_schemas %}
-- ============================================================
-- 2. Revoke CREATE and USAGE on schema "{{ schema }}" from PUBLIC
-- ============================================================
REVOKE CREATE ON SCHEMA {{ schema }} FROM PUBLIC;
REVOKE USAGE ON SCHEMA {{ schema }} FROM PUBLIC;

-- ============================================================
-- 3. Harden default privileges in schema "{{ schema }}"
-- ============================================================
ALTER DEFAULT PRIVILEGES IN SCHEMA {{ schema }}
  REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES IN SCHEMA {{ schema }}
  REVOKE ALL ON SEQUENCES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES IN SCHEMA {{ schema }}
  REVOKE ALL ON FUNCTIONS FROM PUBLIC;

{% if postgresql_srg_revoke_existing_objects | default(false) %}
-- ============================================================
-- 4. Revoke PUBLIC from existing objects in "{{ schema }}"
-- ============================================================
REVOKE ALL ON ALL TABLES IN SCHEMA {{ schema }} FROM PUBLIC;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA {{ schema }} FROM PUBLIC;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA {{ schema }} FROM PUBLIC;
{% endif %}

-- ============================================================
-- 5. RBAC — grant readonly access in schema "{{ schema }}"
-- ============================================================
GRANT USAGE ON SCHEMA {{ schema }} TO {{ postgresql_srg_readonly_role }};
GRANT SELECT ON ALL TABLES IN SCHEMA {{ schema }} TO {{ postgresql_srg_readonly_role }};
ALTER DEFAULT PRIVILEGES IN SCHEMA {{ schema }}
  GRANT SELECT ON TABLES TO {{ postgresql_srg_readonly_role }};

{% endfor %}
